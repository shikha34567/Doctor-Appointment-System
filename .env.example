# Application Environment Configuration
# Copy this file to .env and configure your production values

# Application Secrets
SECRET_KEY=hospital-resource-optimization-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration
# Local development uses SQLite. For PostgreSQL deployment, use:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/hospital_ops
DATABASE_URL=sqlite:///./data/hospital_system.db

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Initial Operations Manager Seed Settings
INITIAL_ADMIN_EMAIL=admin.operations@healthcare.demo
INITIAL_ADMIN_PASSWORD=Admin#Operations2026!
INITIAL_ADMIN_NAME=Hospital Operations Manager
